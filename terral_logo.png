{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emirates-parque-flamboyant",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emirates-ponto-db",
      "database_id": "497a3cae-8439-4495-a1f4-89af2f1e2d9e"
    }
  ]
}